<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/bg_card"
    android:padding="12dp" android:layout_marginTop="8dp">
    <ImageView android:id="@+id/icon" android:layout_width="44dp"
        android:layout_height="44dp" android:layout_marginEnd="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#0D3F5C"
            android:textSize="16sp" android:textStyle="bold" android:singleLine="true" />
        <Spinner android:id="@+id/mode" android:layout_width="match_parent"
            android:layout_height="40dp" android:layout_marginStart="-8dp" />
        <TextView android:id="@+id/pick" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#44A8EB"
            android:textSize="13sp" android:textStyle="bold"
            android:paddingVertical="6dp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
